PORT=3000

# Endereço em que o servidor HTTP escuta. 0.0.0.0 = todas as interfaces (padrão).
# Na VM atrás do nginx, use 127.0.0.1: assim /status e /estou-vivo só são acessíveis por ele.
HTTP_HOST=0.0.0.0

# Postgres local (o docker-compose.yml já sobe com esses valores).
# Na VM: troque pela URL do Postgres nativo, com senha forte.
DATABASE_URL=postgresql://postgres:dev@localhost:5432/wxn

# Pasta onde a sessão do WhatsApp fica salva depois do 1º QR code.
# Na VM, use um caminho fixo fora da pasta do código (ex.: /var/lib/wxn-chatbot/auth).
WHATSAPP_PASTA_SESSAO=./auth_baileys

# --- IA (Gemini) ---------------------------------------------------------
# Chave gratuita em https://aistudio.google.com/apikey
# Deixe vazio para rodar SEM IA: o bot responde sempre com o menu de opções.
# NUNCA suba a chave para o Git (o .env já está no .gitignore).
GEMINI_API_KEY=

# Modelo usado para classificar. Flash-Lite é o mais barato e rápido: sobra para escolher 1 de 5 opções.
GEMINI_MODELO=gemini-3.5-flash-lite

# Tempo máximo esperando o Gemini. Passou disso, o bot mostra o menu.
GEMINI_TIMEOUT_MS=8000

# Abaixo dessa confiança (0 a 1), o bot mostra o menu em vez de adivinhar o tópico.
IA_CONFIANCA_MINIMA=0.6

# --- Excesso de mensagens ------------------------------------------------
# Quantas mensagens por minuto o bot aceita de cada remetente. Passou disso, ele avisa uma vez
# por minuto e ignora o resto: protege a cota da IA e evita loop entre dois robôs. 0 = sem limite.
LIMITE_MENSAGENS_POR_MINUTO=10

# --- "digitando..." (história 1.6) --------------------------------------
# Antes de cada resposta o bot mostra "digitando..." por um tempo proporcional
# ao tamanho do texto, dentro destes limites. O tempo gasto pela IA já conta.
# 0 e 0 desligam o indicador e o atraso.
DIGITANDO_MIN_MS=1500
DIGITANDO_MAX_MS=4000
